generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  username   String     @unique
  full_name  String
  password   String
  role       UserRole   @default(USER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
  stockIns   StockIn[]
  stockOuts  StockOut[]

  @@map("users")
}

model Product {
  id            String     @id @default(cuid())
  name          String
  nameAr        String?
  sku           String     @unique
  barcode       String?    @unique
  qrCode        String?    @unique
  description   String?
  descriptionAr String?
  category      String
  weightPerUnit Float
  minStock      Float      @default(0)
  maxStock      Float?
  currentStock  Float      @default(0)
  unit          String     @default("قطعة")
  imageUrl      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  stockIns      StockIn[]
  stockOuts     StockOut[]
  warehouseBalances WarehouseInventoryBalance[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  barcodes      ProductBarcode[]
  unknownBarcodeEvents UnknownBarcodeEvent[]

  @@map("products")
}

model ProductBarcode {
  id            String   @id @default(cuid())
  productId     String
  code          String   @unique
  identifierType BarcodeIdentifierType @default(PRODUCT_STATIC)
  symbology     BarcodeSymbology @default(CODE_128)
  status        BarcodeStatus @default(ACTIVE)
  issuer        String?
  generatedAt   DateTime @default(now())
  checksumValid Boolean?
  retiredAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@map("product_barcodes")
}

model UnknownBarcodeEvent {
  id             String   @id @default(cuid())
  rawCode        String
  normalizedCode String
  source         String?
  status         UnknownBarcodeStatus @default(OPEN)
  notes          String?
  mappedProductId String?
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  mappedProduct  Product? @relation(fields: [mappedProductId], references: [id], onDelete: SetNull)

  @@index([normalizedCode])
  @@index([status])
  @@map("unknown_barcode_events")
}

model StockIn {
  id            String     @id @default(cuid())
  productId     String
  userId        String
  warehouseId   String?
  scaleId       String?
  quantity      Float
  weight        Float
  scaleWeight   Float?
  capturedAt    DateTime?
  stableWindowMs Int?
  sourceScaleId String?
  confidence    Float?
  captureSource String?
  manualEntryReason String?
  supplier      String?
  invoiceNumber String?
  sourceDocumentType String?
  sourceDocumentNumber String?
  lotBatch      String?
  expiryDate    String?
  supplierLot   String?
  qualityResult String?
  notes         String?
  date          DateTime   @default(now())
  createdAt     DateTime   @default(now())
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  scale         Scale?     @relation(fields: [scaleId], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  inventoryLedgerEntries InventoryLedgerEntry[]

  @@index([productId])
  @@index([userId])
  @@index([warehouseId])
  @@index([scaleId])
  @@index([date])
  @@map("stock_ins")
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  location    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scales      Scale[]
  stockIns    StockIn[]
  stockOuts   StockOut[]
  inventoryBalances WarehouseInventoryBalance[]
  inventoryLedgerEntries InventoryLedgerEntry[]

  @@map("warehouses")
}

model Scale {
  id                   String    @id @default(cuid())
  name                 String
  apiKey               String    @unique @default(cuid())
  bootstrapToken       String?   @unique
  bootstrapTokenExpiresAt DateTime?
  enrolledAt           DateTime?
  retiredAt            DateTime?
  minFirmwareVersion   String?
  deviceType           ScaleDeviceType @default(ESP32)
  firmwareVersion      String?
  lastSeenAt           DateTime?
  printerType          PrinterType?
  printerConnection    Json?
  config               Json?
  warehouseId          String
  tare                 Float     @default(0)
  unit                 String    @default("گرم")
  precision            Int       @default(2)
  locationNote         String?
  heartbeatIntervalSec Int       @default(1)
  lastWeight           Float?
  lastWeightAt         DateTime?
  isActive             Boolean   @default(true)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  warehouse            Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockIns             StockIn[]
  commands             ScaleCommand[]
  telemetries          ScaleTelemetry[]

  @@index([warehouseId])
  @@map("scales")
}

model ScaleCommand {
  id                String   @id @default(cuid())
  scaleId           String
  type              ScaleCommandType
  payload           Json
  status            ScaleCommandStatus @default(PENDING)
  nonce             String?
  ackNonce          String?
  ackNonceExpiresAt DateTime?
  ackedNonce        String?
  requestedByUserId String?
  sentAt            DateTime?
  ackedAt           DateTime?
  expiresAt         DateTime?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  scale             Scale    @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@index([scaleId, status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@map("scale_commands")
}

model ScaleTelemetry {
  id          String   @id @default(cuid())
  scaleId     String
  rssi        Int?
  freeHeap    Int?
  uptimeSec   Int?
  temperature Float?
  battery     Float?
  rebootReason String?
  diagnostics Json?
  payload     Json?
  createdAt   DateTime @default(now())
  scale       Scale    @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@index([scaleId, createdAt])
  @@map("scale_telemetry")
}

model StockOut {
  id            String   @id @default(cuid())
  productId     String
  userId        String
  warehouseId   String?
  quantity      Float
  weight        Float
  customer      String?
  invoiceNumber String?
  notes         String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  inventoryLedgerEntries InventoryLedgerEntry[]

  @@index([productId])
  @@index([userId])
  @@index([warehouseId])
  @@index([date])
  @@map("stock_outs")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

enum BarcodeStatus {
  ACTIVE
  RETIRED
}

enum BarcodeIdentifierType {
  PRODUCT_STATIC
  PACKAGE_DYNAMIC
  LOT_DYNAMIC
  SUPPLIER_ALIAS
}

enum BarcodeSymbology {
  EAN_13
  EAN_8
  CODE_128
  QR
  UNKNOWN
}


enum PrintJobStatus {
  QUEUED
  SENT
  FAILED
  REPRINT
}

enum UnknownBarcodeStatus {
  OPEN
  TEMP_RECEIVING
  MAPPED
}


model PrintJob {
  id              String   @id @default(cuid())
  stockInId       String?
  userId          String
  templateVersion String
  labelSize       String
  status          PrintJobStatus @default(QUEUED)
  payload         Json
  errorMessage    String?
  createdAt       DateTime @default(now())
  sentAt          DateTime?
  failedAt        DateTime?

  @@index([status, createdAt])
  @@index([stockInId])
  @@map("print_jobs")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String
  endpoint       String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model WarehouseInventoryBalance {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  lotBatch    String   @default("")
  quantity    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId, lotBatch])
  @@index([warehouseId])
  @@index([productId])
  @@map("warehouse_inventory_balances")
}

model InventoryLedgerEntry {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  lotBatch    String   @default("")
  quantityDelta Float
  movementType InventoryMovementType
  stockInId   String?
  stockOutId  String?
  notes       String?
  createdAt   DateTime @default(now())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockIn     StockIn? @relation(fields: [stockInId], references: [id], onDelete: SetNull)
  stockOut    StockOut? @relation(fields: [stockOutId], references: [id], onDelete: SetNull)

  @@index([productId, warehouseId, createdAt])
  @@index([movementType, createdAt])
  @@map("inventory_ledger_entries")
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  STOCK_OUT_UNDO
}

enum ScaleDeviceType {
  ESP32
}

enum PrinterType {
  TSPL
  ESC_POS
}

enum ScaleCommandType {
  PRINT_LABEL
  PRINT_TEST
  SET_CONFIG
  RESTART
}

enum ScaleCommandStatus {
  PENDING
  SENT
  ACKED
  FAILED
  EXPIRED
}
