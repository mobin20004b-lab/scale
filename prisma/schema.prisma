generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  username   String     @unique
  full_name  String
  password   String
  role       UserRole   @default(USER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
  stockIns   StockIn[]
  stockOuts  StockOut[]

  @@map("users")
}

model Product {
  id            String     @id @default(cuid())
  name          String
  nameAr        String?
  sku           String     @unique
  barcode       String?    @unique
  qrCode        String?    @unique
  description   String?
  descriptionAr String?
  category      String
  weightPerUnit Float
  minStock      Float      @default(0)
  maxStock      Float?
  currentStock  Float      @default(0)
  unit          String     @default("قطعة")
  imageUrl      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  stockIns      StockIn[]
  stockOuts     StockOut[]

  @@map("products")
}

model StockIn {
  id            String     @id @default(cuid())
  productId     String
  userId        String
  warehouseId   String?
  scaleId       String?
  quantity      Float
  weight        Float
  scaleWeight   Float?
  supplier      String?
  invoiceNumber String?
  sourceDocumentType String?
  sourceDocumentNumber String?
  lotBatch      String?
  expiryDate    String?
  supplierLot   String?
  qualityResult String?
  notes         String?
  date          DateTime   @default(now())
  createdAt     DateTime   @default(now())
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  scale         Scale?     @relation(fields: [scaleId], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([warehouseId])
  @@index([scaleId])
  @@index([date])
  @@map("stock_ins")
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  location    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scales      Scale[]
  stockIns    StockIn[]
  stockOuts   StockOut[]

  @@map("warehouses")
}

model Scale {
  id                   String    @id @default(cuid())
  name                 String
  apiKey               String    @unique @default(cuid())
  warehouseId          String
  tare                 Float     @default(0)
  unit                 String    @default("گرم")
  precision            Int       @default(2)
  locationNote         String?
  heartbeatIntervalSec Int       @default(1)
  lastWeight           Float?
  lastWeightAt         DateTime?
  isActive             Boolean   @default(true)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  warehouse            Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockIns             StockIn[]

  @@index([warehouseId])
  @@map("scales")
}

model StockOut {
  id            String   @id @default(cuid())
  productId     String
  userId        String
  warehouseId   String?
  quantity      Float
  weight        Float
  customer      String?
  invoiceNumber String?
  notes         String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([warehouseId])
  @@index([date])
  @@map("stock_outs")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String
  endpoint       String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_records")
}
